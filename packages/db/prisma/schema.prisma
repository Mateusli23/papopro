// PapoPro — schema Prisma.
//
// M7#2 introduz o esqueleto multi-tenant + auditoria: users (espelha auth.users
// via trigger on_auth_user_created), workspaces, workspace_members, invitations,
// audit_logs, notification_preferences, webhook_events. RLS habilitada em todas
// as tabelas pelo SQL aplicado via MCP apply_migration (init_auth_and_multi_tenant).
//
// M8#1 acrescenta o domínio CRM core: leads, deals, pipelines + pipeline_stages,
// tags + lead_tags (m:n), tasks, activities, attachments, custom_fields +
// lead_custom_values. Campos refletem o que a UI de M4/M5 já espera (mapeado em
// apps/web/features/leads/types.ts e fixtures em apps/web/lib/fixtures/). RLS
// segue o padrão de M7#2 — `current_workspace_id()` filtrando por tenant ativo.
//
// Source of truth: este arquivo. SQL DDL/RLS é gerado manualmente espelhando os
// models e aplicado no Supabase via supabase/migrations/. Ver [docs/PLAN.md]
// §M7 e §M8.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, pg_trgm, vector, citext]
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  Owner
  Admin
  Manager
  Vendedor
  Viewer

  @@map("role")
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked

  @@map("invitation_status")
}

enum AuditAction {
  workspace_created
  workspace_updated
  member_invited
  member_joined
  member_role_changed
  member_removed
  invitation_revoked
  user_logged_in
  user_logged_out
  export_started
  data_deleted
  lead_created
  lead_updated
  lead_deleted
  deal_created
  deal_updated
  deal_stage_changed
  task_created
  task_completed
  webhook_token_regenerated
  attachment_uploaded
  attachment_deleted
  whatsapp_connected
  whatsapp_disconnected
  whatsapp_message_sent
  whatsapp_blocked_optout
  quick_reply_created
  quick_reply_deleted
  conversation_archived
  conversation_transferred
  // M10#1 — motor de cadência + cold lead detector (PG enum values criados via
  // ALTER TYPE ADD VALUE em supabase/migrations/20260521120000_m10_1_cadence_schema.sql).
  // M10#2 declara aqui pro Prisma client tipar `tx.auditLog.create({action: 'cadence_step_sent', ...})`
  // sem TS error. Ordem espelha a do SQL.
  cadence_created
  cadence_updated
  cadence_deleted
  cadence_enrolled
  cadence_paused
  cadence_reactivated
  cadence_completed
  cadence_step_sent
  cadence_step_failed
  cold_lead_alerted
  cold_lead_acknowledged
  cold_threshold_updated

  @@map("audit_action")
}

// =============================================================================
// Enums de domínio (M8#1)
// =============================================================================

/// Origem do lead — preenchida no create (manual, import CSV, webhook ads, etc.).
/// Espelha `apps/web/features/leads/types.ts:LeadOrigin` (9 valores). Em M9 a
/// origem `whatsapp_inbound` vira automática (lead criado quando chega mensagem
/// de número desconhecido); por enquanto entra manual ou via webhook.
enum LeadOrigin {
  site
  meta_ads
  google_ads
  indicacao
  whatsapp_inbound
  csv_import
  manual
  rd_station
  hotmart
  webhook_generico

  @@map("lead_origin")
}

/// Status do lead — `arquivado` é soft-archive (UI esconde de listas default);
/// `perdido`/`ganho` são terminais e fecham a relação. Soft-delete real (linha
/// some) usa `deletedAt`, separado do status (LGPD §17).
enum LeadStatus {
  ativo
  arquivado
  perdido
  ganho

  @@map("lead_status")
}

/// Status da oportunidade comercial. Lead pode ter múltiplos deals abertos
/// (clientes recorrentes, propostas paralelas) — `won/lost` fecha o deal,
/// não o lead. Espelha `apps/web/features/deals/types.ts:DealStatus`.
enum DealStatus {
  open
  won
  lost

  @@map("deal_status")
}

/// Tipo da tarefa — usado pra ícone na lista e pra agrupar relatórios.
enum TaskKind {
  call
  whatsapp
  email
  meeting
  follow_up
  other

  @@map("task_kind")
}

/// Status da tarefa. `snoozed` é "adia 1d/3d/7d" — UI esconde até o `dueAt`
/// novo. Diferente de `pending` pra distinguir adiada vs nunca-tocada.
enum TaskStatus {
  pending
  done
  snoozed

  @@map("task_status")
}

/// Tipo de evento na timeline do lead — append-only. Cada evento de domínio
/// (mover etapa, criar task, anexar arquivo) grava 1 linha em `activities`.
/// Mensagens WhatsApp (`whatsapp_in`/`whatsapp_out`) entram em M9 quando o
/// adapter conectar — entradas aqui são placeholder até lá.
enum ActivityType {
  whatsapp_in
  whatsapp_out
  call
  email
  meeting
  note
  task
  stage_change
  attachment
  lead_created

  @@map("activity_type")
}

/// Tom semântico da etapa pra UI — `success` em "Ganho", `destructive` em
/// "Perdido", `default` no resto. Persistido aqui pra que pipelines custom
/// (M8#2+) possam marcar suas próprias etapas terminais.
enum StageTone {
  default
  success
  destructive

  @@map("stage_tone")
}

/// Tipo do custom field. Schema cobre M8#1 já — UI de configuração entra
/// numa onda posterior (M8 polimento). `enum` armazena opções em `options`
/// JSONB do CustomField.
enum CustomFieldType {
  text
  number
  date
  enum

  @@map("custom_field_type")
}

// =============================================================================
// Enums de WhatsApp (M9#1)
// =============================================================================

/// Direção da mensagem em relação ao workspace.
///  - `out`: enviada pelo vendedor (vai pro lead)
///  - `in`: recebida do lead (chegou no número conectado)
/// Espelha `apps/web/features/inbox/types.ts:MessageDirection`.
enum MessageDirection {
  in
  out

  @@map("message_direction")
}

/// Tipos de mensagem suportados pelo WhatsApp. M9 entrega só `text` +
/// `internal_note`; mídia (`image`/`audio`/`document`) entra em M9.x/M10.
/// `internal_note` NÃO vai pro lead — visível só ao time (sempre out).
enum MessageKind {
  text
  image
  audio
  document
  internal_note

  @@map("message_kind")
}

/// Status agregado da conversa, denormalizado em `Conversation.status` pra
/// simplificar filtros sem indexar a última mensagem.
///  - `awaiting`: vendedor mandou e aguarda resposta
///  - `responded`: lead respondeu, vendedor precisa agir
///  - `archived`: conversa resolvida (PRD §3.8)
enum ConversationStatus {
  awaiting
  responded
  archived

  @@map("conversation_status")
}

/// Saúde da conexão WhatsApp do workspace (CLAUDE.md §9 Health Score).
///  - `healthy` (verde): tudo OK, envios autorizados
///  - `degraded` (amarelo): heartbeat oscilando
///  - `unhealthy` (vermelho): offline, envios pausados automaticamente
enum HealthScore {
  healthy
  degraded
  unhealthy

  @@map("health_score")
}

// =============================================================================
// Tenant + identidade
// =============================================================================

/// Tenant isolado. Toda tabela de domínio referencia workspaces.id.
model Workspace {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(60)
  slug      String    @unique @db.VarChar(80)
  logoUrl   String?   @map("logo_url")
  segment   String?   @db.VarChar(32)
  plan      String    @default("Pro") @db.VarChar(32)
  timezone  String    @default("America/Sao_Paulo") @db.VarChar(64)
  locale    String    @default("pt-BR") @db.VarChar(8)
  settings  Json      @default("{}")
  /// Token URL-safe para o endpoint `POST /api/webhooks/leads/[token]` (M8#5).
  /// Gerado via `randomBytes(32).toString('base64url')` no `createWorkspaceAction`
  /// e regenerável por Owner/Admin em Settings → Connections. Unique pra que
  /// o lookup do route handler seja O(log n) e nunca colida entre workspaces.
  webhookToken String?  @unique @map("webhook_token") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  members                 WorkspaceMember[]
  invitations             Invitation[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreference[]
  webhookEvents           WebhookEvent[]
  pipelines               Pipeline[]
  leads                   Lead[]
  deals                   Deal[]
  tags                    Tag[]
  tasks                   Task[]
  activities              Activity[]
  attachments             Attachment[]
  customFields            CustomField[]
  whatsappAccount         WhatsappAccount?
  whatsappInstances       WhatsappInstance[]
  conversations           Conversation[]
  messages                Message[]
  quickReplies            QuickReply[]
  blacklist               BlackList[]
  whatsappEvents          WhatsappEvent[]

  @@index([deletedAt])
  @@map("workspaces")
}

/// Espelha auth.users via trigger on_auth_user_created.
/// Não inserir diretamente — Supabase Auth gerencia. id é o mesmo UUID de auth.users.id.
///
/// **Invariante de `email` (M7#5 HIGH #11):** a coluna é `@db.Citext` —
/// comparação case-insensitive *no Postgres*. Mas o Prisma client recebe e
/// retorna o valor literal como veio, sem normalizar. Toda escrita no app
/// (signup, upsert defensivo em workspace/invitations actions) deve passar
/// por `.toLowerCase().trim()` antes — caso contrário, dois "Foo@bar.com" e
/// "foo@bar.com" produzem 1 linha em SELECT (citext) mas o cache da app vê
/// strings diferentes em dois callsites. Convenção: normalizar na borda
/// (Server Action), confiar no tipo internamente.
model User {
  id              String    @id @db.Uuid
  email           String    @unique @db.Citext
  name            String?   @db.VarChar(120)
  avatarUrl       String?   @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships             WorkspaceMember[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreference[]
  invitationsCreated      Invitation[]             @relation("InvitationCreatedBy")
  attachmentsUploaded     Attachment[]             @relation("AttachmentUploadedBy")

  @@map("users")
}

/// Relação usuário ↔ workspace com papel RBAC.
model WorkspaceMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        Role
  invitedAt   DateTime? @map("invited_at") @db.Timestamptz(6)
  joinedAt    DateTime? @map("joined_at") @db.Timestamptz(6)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  leadsAssigned         Lead[]         @relation("LeadAssignee")
  dealsOwned            Deal[]         @relation("DealOwner")
  tasksAssigned         Task[]         @relation("TaskAssignee")
  activitiesAuthor      Activity[]     @relation("ActivityAuthor")
  conversationsAsVendor Conversation[] @relation("ConversationVendor")
  messagesAuthored      Message[]      @relation("MessageAuthor")

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

/// Convite por email com magic link. TTL 7 dias (gerenciado no app).
model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  email       String           @db.Citext
  role        Role
  token       String           @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  status      InvitationStatus @default(pending)
  createdById String           @map("created_by_id") @db.Uuid
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([token])
  @@map("invitations")
}

// =============================================================================
// Auditoria + preferências + webhooks
// =============================================================================

/// Log de auditoria (LGPD). Append-only — nenhuma policy de UPDATE/DELETE.
/// Cleanup futuro via pg_cron com retenção 12m (Pro) / 24m (Enterprise).
model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  action      AuditAction
  entityType  String?     @map("entity_type") @db.VarChar(64)
  entityId    String?     @map("entity_id") @db.VarChar(64)
  changes     Json?
  ipAddress   String?     @map("ip_address") @db.Inet
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, userId])
  @@map("audit_logs")
}

/// Preferências de notificação por (workspace, user). JSONB wide.
/// Eventos administrativos (workspace_invite_received, payment_failed) NÃO ficam aqui
/// — são forçados na camada de envio (PRD §3.2 "não podem ser desligados").
model NotificationPreference {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  prefs       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("notification_preferences")
}

/// Idempotência de webhooks externos. (source, externalId) único.
/// Append-only — nenhuma policy de UPDATE/DELETE.
model WebhookEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  source         String    @db.VarChar(32)
  externalId     String    @map("external_id") @db.VarChar(128)
  payload        Json
  signatureValid Boolean   @default(false) @map("signature_valid")
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([workspaceId, source, createdAt(sort: Desc)])
  @@map("webhook_events")
}

// =============================================================================
// Domínio CRM (M8#1)
// =============================================================================

/// Funil de vendas. Cada workspace tem 1+ pipelines; um é `isDefault=true` e
/// `createWorkspaceAction` semeia 6 etapas padrão (Novo → … → Ganho/Perdido).
/// Custom pipelines (M8#2+) podem ter qualquer número de etapas com `order`
/// definido pelo Owner/Admin.
///
/// **Soft-delete:** `deletedAt` esconde da UI mas mantém histórico — leads e
/// deals que referenciavam etapas dessa pipeline continuam válidos (FK Restrict
/// nas etapas garante que pipeline com tráfego não some).
model Pipeline {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String    @db.VarChar(80)
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]

  @@index([workspaceId])
  @@index([workspaceId, isDefault])
  @@map("pipelines")
}

/// Etapa do funil. `order` define a sequência visual no Kanban (1-indexed,
/// crescente da esquerda pra direita). `rotDays` é o número de dias após os
/// quais um deal "esfria" nessa etapa — usado pelo detector de lead frio (M10).
/// `terminal=true` impede cadências (M10) de re-engajar e marca a etapa como
/// final no funil (Ganho/Perdido).
///
/// **Slug** é estável e único por pipeline — usado nas FKs de leads/deals em
/// vez do UUID pra que a UI possa fazer `where: { stageId: 'novo' }` sem
/// lookup. O ID UUID é a verdadeira PK; o slug é só conveniência de API.
model PipelineStage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId String    @map("pipeline_id") @db.Uuid
  slug       String    @db.VarChar(64)
  name       String    @db.VarChar(80)
  order      Int
  rotDays    Int       @default(0) @map("rot_days")
  terminal   Boolean   @default(false)
  tone       StageTone @default(default)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]
  deals    Deal[]

  @@unique([pipelineId, slug])
  @@unique([pipelineId, order])
  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

/// Contato cru — pessoa/empresa com potencial de virar oportunidade. Em
/// imobiliário/B2B/alto-ticket (beachhead PapoPro), um lead pode gerar 0..N
/// deals ao longo do tempo (compra de imóvel A, recompra de imóvel B etc.).
///
/// **`temperature` NÃO é coluna persistida** — é derivada de `lastInteractionAt`
/// em query/view. Decisão: schema mais simples, computa na borda. Se virar
/// gargalo de performance, criamos VIEW materializada.
///
/// **`stageId`** referencia a "etapa principal" do lead (pra UI de lista densa
/// mostrar). O estado canônico da oportunidade vive em `Deal.stageId` — Kanban
/// lê de lá, não daqui.
model Lead {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String     @map("workspace_id") @db.Uuid
  name              String     @db.VarChar(120)
  email             String?    @db.Citext
  phone             String     @db.VarChar(32)
  company           String?    @db.VarChar(120)
  position          String?    @db.VarChar(80)
  origin            LeadOrigin @default(manual)
  status            LeadStatus @default(ativo)
  stageId           String     @map("stage_id") @db.Uuid
  assignedToId      String     @map("assigned_to_id") @db.Uuid
  valueCents        Int        @default(0) @map("value_cents")
  notes             String?
  lastInteractionAt DateTime?  @map("last_interaction_at") @db.Timestamptz(6)
  nextActionAt      DateTime?  @map("next_action_at") @db.Timestamptz(6)
  nextActionLabel   String?    @map("next_action_label") @db.VarChar(120)
  createdById       String?    @map("created_by_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage         PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  assignedTo    WorkspaceMember   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  attachments   Attachment[]
  tags          LeadTag[]
  customValues  LeadCustomValue[]
  conversations Conversation[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([workspaceId, stageId])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, lastInteractionAt(sort: Desc)])
  @@index([workspaceId, deletedAt])
  @@map("leads")
}

/// Oportunidade comercial — `(leadId, stageId)` representa "lead X está na
/// etapa Y do funil Z com valor V". Lead pode ter múltiplos deals abertos:
/// imóvel A em "Negociação" + imóvel B em "Proposta". O Kanban lê desta tabela.
///
/// **Soft-archive via `status`**, soft-delete via `deletedAt`. Diferente:
/// `status=lost` registra perda com `lostReason`; `deletedAt` é "remover por
/// erro de digitação" (raro mas LGPD §17 exige).
model Deal {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  title        String     @db.VarChar(160)
  leadId       String     @map("lead_id") @db.Uuid
  stageId      String     @map("stage_id") @db.Uuid
  valueCents   Int        @default(0) @map("value_cents")
  ownerId      String     @map("owner_id") @db.Uuid
  probability  Int?
  dueAt        DateTime?  @map("due_at") @db.Timestamptz(6)
  description  String?
  status       DealStatus @default(open)
  lostReason   String?    @map("lost_reason")
  orderInStage Int        @default(0) @map("order_in_stage")
  closedAt     DateTime?  @map("closed_at") @db.Timestamptz(6)
  createdById  String?    @map("created_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage     PipelineStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner     WorkspaceMember @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([workspaceId, stageId, orderInStage])
  @@index([workspaceId, status])
  @@index([workspaceId, ownerId])
  @@index([leadId])
  @@index([workspaceId, deletedAt])
  @@map("deals")
}

/// Tag livre — criada inline no form de lead. Por workspace, unique por nome
/// (case-insensitive via citext). UI permite até 8 por lead (enforced no app).
model Tag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.Citext
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadTags  LeadTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("tags")
}

/// Junction lead ↔ tag (m:n).
model LeadTag {
  leadId    String   @map("lead_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
  @@map("lead_tags")
}

/// Tarefa vinculada a um lead. `kind` é só ícone/agrupamento de relatório;
/// `dueAt` é o que dispara a coluna "atrasadas" no /tasks. `snoozed` é estado
/// intermediário entre `pending` e `done` — adiada por N dias, some da UI até
/// o `dueAt` novo.
model Task {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  leadId       String     @map("lead_id") @db.Uuid
  kind         TaskKind
  title        String     @db.VarChar(160)
  notes        String?
  dueAt        DateTime   @map("due_at") @db.Timestamptz(6)
  status       TaskStatus @default(pending)
  assignedToId String     @map("assigned_to_id") @db.Uuid
  doneAt       DateTime?  @map("done_at") @db.Timestamptz(6)
  createdById  String?    @map("created_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo WorkspaceMember @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, assignedToId])
  @@index([leadId])
  @@map("tasks")
}

/// Timeline append-only do lead. Cada evento de domínio (mudança de etapa,
/// criar task, anexar arquivo, mensagem WhatsApp em M9) grava 1 linha aqui.
/// **Sem update/delete** — policy RLS proíbe; LGPD permite anonimização via
/// reescrita de `body` se solicitado.
///
/// `authorId` opcional pra eventos de sistema (`stage_change` automático por
/// cadência, por exemplo). `meta` JSONB carrega contexto específico do tipo
/// (fromStageId/toStageId em stage_change, durationSeconds em call, etc.).
model Activity {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  leadId      String       @map("lead_id") @db.Uuid
  type        ActivityType
  body        String?
  authorId    String?      @map("author_id") @db.Uuid
  meta        Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    WorkspaceMember? @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, leadId, createdAt(sort: Desc)])
  @@index([leadId, createdAt(sort: Desc)])
  @@index([workspaceId, type])
  @@map("activities")
}

/// Anexo de lead — arquivo armazenado no Supabase Storage bucket `attachments`.
/// `path` é o storage path completo (`<workspaceId>/<leadId>/<uuid>-<filename>`);
/// `bucket` permite migrar pra outro bucket no futuro sem alterar schema.
///
/// **Cleanup de órfãos:** `pg_cron` diário em M8#6 vai varrer linhas com
/// `deletedAt > 30 dias` e apagar o objeto no Storage. Até lá, soft-delete só
/// esconde da UI.
model Attachment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  bucket       String    @default("attachments") @db.VarChar(64)
  path         String
  fileName     String    @map("file_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(127)
  sizeBytes    Int       @map("size_bytes")
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, leadId, createdAt(sort: Desc)])
  @@index([workspaceId, deletedAt])
  @@map("attachments")
}

/// Campo customizado por workspace — Owner/Admin define no settings o que
/// quer rastrear além dos campos default (ex: "metragem", "andar", "ICP score").
/// Schema preparado em M8#1; UI de gestão entra numa onda posterior.
model CustomField {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  key         String          @db.VarChar(64)
  label       String          @db.VarChar(120)
  type        CustomFieldType
  options     Json?
  order       Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    LeadCustomValue[]

  @@unique([workspaceId, key])
  @@index([workspaceId, order])
  @@map("custom_fields")
}

/// Valor do custom field pra um lead específico — JSONB porque o tipo varia
/// (text/number/date/enum). Trade-off conhecido: queries em valores custom
/// usam GIN sobre `value` em vez de índices nativos; performance OK pra
/// volume MVP, revisamos se virar gargalo.
model LeadCustomValue {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId        String   @map("lead_id") @db.Uuid
  customFieldId String   @map("custom_field_id") @db.Uuid
  value         Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, customFieldId])
  @@index([customFieldId])
  @@map("lead_custom_values")
}

// =============================================================================
// WhatsApp (M9#1)
// =============================================================================
//
// Schema preparado em M9#1 (sem actions/webhook/heartbeat ainda — esses entram
// em M9#2..M9#5). Espelha o contrato fechado em `apps/web/features/inbox/types.ts`
// e `apps/web/features/inbox/schemas.ts`. Decisões fechadas:
//   - 1 número por workspace (Workspace 1—1 WhatsappAccount).
//   - MVP só `text` + `internal_note` (mídia em M9.x/M10).
//   - Lead inbound desconhecido vira lead automático com round-robin (M9#3).
//   - Opt-out `^(pare|sair|cancelar)$` → BlackList (M9#3).

/// Conta WhatsApp do workspace — 1:1 com Workspace. Cobre o número conectado
/// via uazapi (Standard, Pro/Pro IA). Cloud API Meta (Enterprise, V2) entra
/// pelo mesmo modelo, só varia `provider`.
///
/// **`phoneNumber`** é a referência humana — gravada quando a sessão fica
/// `connected` pela primeira vez (uazapi expõe via `getInstanceStatus`). Antes
/// disso fica vazio mas o registro existe pra ancorar a `WhatsappInstance`.
model WhatsappAccount {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  phoneNumber String   @default("") @map("phone_number") @db.VarChar(32)
  displayName String?  @map("display_name") @db.VarChar(120)
  provider    String   @default("uazapi") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instance      WhatsappInstance?
  conversations Conversation[]

  @@map("whatsapp_accounts")
}

/// Sessão atual da conta WhatsApp — armazena estado dinâmico (status, QR code,
/// health, anti-ban). Separado de `WhatsappAccount` porque a conta é estável
/// (1 número por workspace) mas a sessão pode ser reiniciada (regenerar QR,
/// reconectar) sem perder o histórico de mensagens vinculadas à conta.
///
/// **`status`** intencionalmente string (não enum): a evolução de estados
/// uazapi/cloud é frequente (`connecting`/`pairing`/`connected`/`disconnected`/
/// `banned`/...) e enum exigiria migration por valor. Validação aplicada na
/// borda via Zod no M9#2.
///
/// **`messagesSent24h`** + **`pausedUntil`**: ganchos do anti-ban (M9#3). O
/// detector de health score (M9#5) decide quando pausar baseado em queda de
/// heartbeat ou ratio de bloqueios.
model WhatsappInstance {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String      @map("workspace_id") @db.Uuid
  accountId           String      @unique @map("account_id") @db.Uuid
  externalInstanceId  String?     @map("external_instance_id") @db.VarChar(128)
  status              String      @default("disconnected") @db.VarChar(24)
  healthScore         HealthScore @default(healthy) @map("health_score")
  qrCode              String?     @map("qr_code")
  qrExpiresAt         DateTime?   @map("qr_expires_at") @db.Timestamptz(6)
  lastSeenAt          DateTime?   @map("last_seen_at") @db.Timestamptz(6)
  connectedAt         DateTime?   @map("connected_at") @db.Timestamptz(6)
  disconnectedAt      DateTime?   @map("disconnected_at") @db.Timestamptz(6)
  messagesSent24h     Int         @default(0) @map("messages_sent_24h")
  pausedUntil         DateTime?   @map("paused_until") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([lastSeenAt])
  @@map("whatsapp_instances")
}

/// Conversa entre o número do workspace e um contato. Espelha
/// `features/inbox/types.ts:Conversation`. **Unique por `(workspaceId,
/// contactPhone)`** porque só temos 1 número por workspace (decisão M9 fechada),
/// então cada telefone gera 1 conversa contínua.
///
/// **`status`** é denormalizado (não derivado) — facilita filtros sem indexar
/// a última mensagem. Atualizado nas mutations (`sendText` → awaiting, inbound
/// → responded, `archive` → archived).
///
/// **`lastMessagePreview`** + **`lastMessageDirection`** + **`lastMessageAt`**
/// denormalizados pra que a lista de conversas (sidebar Inbox) não precise de
/// subquery `ORDER BY messages.created_at DESC LIMIT 1` por linha. Renderização
/// O(1) em workspaces com 1000+ conversas.
model Conversation {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String              @map("workspace_id") @db.Uuid
  leadId               String              @map("lead_id") @db.Uuid
  vendorId             String?             @map("vendor_id") @db.Uuid
  whatsappAccountId    String              @map("whatsapp_account_id") @db.Uuid
  contactPhone         String              @map("contact_phone") @db.VarChar(32)
  status               ConversationStatus  @default(awaiting)
  lastMessageAt        DateTime?           @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview   String?             @map("last_message_preview") @db.VarChar(280)
  lastMessageDirection MessageDirection?   @map("last_message_direction")
  unreadCount          Int                 @default(0) @map("unread_count")
  archivedAt           DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead             Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendor           WorkspaceMember? @relation("ConversationVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  whatsappAccount  WhatsappAccount  @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@unique([workspaceId, contactPhone])
  @@index([workspaceId, status, lastMessageAt(sort: Desc)])
  @@index([workspaceId, vendorId])
  @@index([leadId])
  @@map("conversations")
}

/// Mensagem trocada na conversa. Append-only (sem update do body / direction /
/// kind — só `readAt` e `deliveredAt` mudam após criação). Espelha
/// `features/inbox/types.ts:Message`.
///
/// **`externalMessageId`** é o ID do provedor (uazapi `message_id`). Usado pra
/// idempotência inbound — webhook recebe múltiplas entregas do mesmo evento e
/// dedupa por `(workspaceId, externalMessageId)`. Como é nullable (mensagens
/// outbound geradas antes de receber ACK podem ainda não ter ID), o unique é
/// **partial** (`WHERE external_message_id IS NOT NULL`) declarado no SQL
/// manual — Prisma 5 não suporta `WHERE` em `@@unique`. Aqui só o índice.
///
/// **`authorId`** null para inbound (`direction='in'`). Outbound sempre tem
/// autor (vendedor humano ou agente IA em M11).
model Message {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String           @map("workspace_id") @db.Uuid
  conversationId       String           @map("conversation_id") @db.Uuid
  kind                 MessageKind
  direction            MessageDirection
  body                 String?
  authorId             String?          @map("author_id") @db.Uuid
  externalMessageId    String?          @map("external_message_id") @db.VarChar(128)
  deliveredAt          DateTime?        @map("delivered_at") @db.Timestamptz(6)
  readAt               DateTime?        @map("read_at") @db.Timestamptz(6)
  mediaName            String?          @map("media_name") @db.VarChar(255)
  mediaSizeKb          Int?             @map("media_size_kb")
  mediaDurationSeconds Int?             @map("media_duration_seconds")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       WorkspaceMember? @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, conversationId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([workspaceId, externalMessageId])
  @@map("messages")
}

/// Template de resposta rápida do composer da Inbox (PRD §3.8). Por workspace,
/// unique por `label` pra evitar chips duplicados na barra. `body` pode conter
/// placeholders `{nome}` / `{empresa}` / `{produto}` resolvidos contra o lead
/// da conversa atual no client.
model QuickReply {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  label       String   @db.VarChar(80)
  body        String
  order       Int      @default(0)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
  @@index([workspaceId, order])
  @@map("quick_replies")
}

/// Opt-out LGPD (CLAUDE.md §7.5). Detecção automática via regex
/// `^(pare|sair|cancelar)$` no webhook inbound (M9#3) insere row aqui +
/// activity `opt_out` no lead + audit `whatsapp_blocked_optout`. Anti-ban
/// (`lib/whatsapp/anti-ban.ts` M9#3) consulta `(workspaceId, phone)` antes de
/// liberar qualquer envio. `reason` permite distinguir opt-out automático
/// de bloqueio manual ou marcação de spam.
model BlackList {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  phone       String   @db.VarChar(32)
  reason      String   @default("opt_out") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@map("blacklist")
}

/// Eventos da sessão WhatsApp — separado de `WebhookEvent` (M7#2/M8#5) que é
/// genérico por `(source, externalId)`. Aqui armazenamos eventos
/// específicos do ciclo de vida da conexão (connected/disconnected/qr_refreshed/
/// heartbeat_ok/heartbeat_fail) pra observability + debug. Append-only.
model WhatsappEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  instanceId  String?  @map("instance_id") @db.Uuid
  type        String   @db.VarChar(32)
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([instanceId, type, createdAt(sort: Desc)])
  @@map("whatsapp_events")
}
