// PapoPro — schema Prisma.
//
// M7#2 introduz o esqueleto multi-tenant + auditoria: users (espelha auth.users
// via trigger on_auth_user_created), workspaces, workspace_members, invitations,
// audit_logs, notification_preferences, webhook_events. RLS habilitada em todas
// as tabelas pelo SQL aplicado via MCP apply_migration (init_auth_and_multi_tenant).
//
// M8#1 acrescenta o domínio CRM core: leads, deals, pipelines + pipeline_stages,
// tags + lead_tags (m:n), tasks, activities, attachments, custom_fields +
// lead_custom_values. Campos refletem o que a UI de M4/M5 já espera (mapeado em
// apps/web/features/leads/types.ts e fixtures em apps/web/lib/fixtures/). RLS
// segue o padrão de M7#2 — `current_workspace_id()` filtrando por tenant ativo.
//
// Source of truth: este arquivo. SQL DDL/RLS é gerado manualmente espelhando os
// models e aplicado no Supabase via supabase/migrations/. Ver [docs/PLAN.md]
// §M7 e §M8.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, pg_trgm, vector, citext]
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  Owner
  Admin
  Manager
  Vendedor
  Viewer

  @@map("role")
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked

  @@map("invitation_status")
}

enum AuditAction {
  workspace_created
  workspace_updated
  member_invited
  member_joined
  member_role_changed
  member_removed
  invitation_revoked
  user_logged_in
  user_logged_out
  export_started
  data_deleted
  lead_created
  lead_updated
  lead_deleted
  deal_created
  deal_updated
  deal_stage_changed
  task_created
  task_completed
  webhook_token_regenerated
  attachment_uploaded
  attachment_deleted
  whatsapp_connected
  whatsapp_disconnected
  whatsapp_message_sent
  whatsapp_blocked_optout
  quick_reply_created
  quick_reply_deleted
  conversation_archived
  conversation_transferred
  // M10#1 — motor de cadência + cold lead detector (PG enum values criados via
  // ALTER TYPE ADD VALUE em supabase/migrations/20260521120000_m10_1_cadence_schema.sql).
  // M10#2 declara aqui pro Prisma client tipar `tx.auditLog.create({action: 'cadence_step_sent', ...})`
  // sem TS error. Ordem espelha a do SQL.
  cadence_created
  cadence_updated
  cadence_deleted
  cadence_enrolled
  cadence_paused
  cadence_reactivated
  cadence_completed
  cadence_step_sent
  cadence_step_failed
  cold_lead_alerted
  cold_lead_acknowledged
  cold_threshold_updated
  // M12#1 — Stripe billing (PG enum values criados via
  // ALTER TYPE ADD VALUE em supabase/migrations/20260525120000_m12_1_billing_schema.sql).
  checkout_initiated
  subscription_activated
  subscription_canceled
  payment_succeeded
  payment_failed
  // M11#1 — Agentes IA + Cérebro da Empresa (PG enum values criados via
  // ALTER TYPE ADD VALUE em supabase/migrations/20260526120000_m11_1_ai_agents_schema.sql).
  agent_created
  agent_version_saved
  agent_activated
  agent_paused
  agent_deleted
  handoff_triggered
  handoff_reverted
  knowledge_doc_uploaded
  knowledge_doc_processed

  @@map("audit_action")
}

/// Plano da subscription Stripe (M12#1). MVP só `pro`; M12#2+ adiciona
/// `pro_ia` e `enterprise`. Workspace sem subscription ativa = plano `free`
/// (derivado da ausência de row em `subscriptions`).
enum SubscriptionPlan {
  pro

  @@map("subscription_plan")
}

/// Status da subscription Stripe (M12#1). Reflete `subscription.status` da
/// API Stripe. Excluímos `trialing`/`paused` por enquanto — entram em M12#3
/// (trial 7d sem cartão). `incomplete_expired` agrupado em `canceled`.
enum SubscriptionStatus {
  active
  past_due
  canceled
  unpaid
  incomplete

  @@map("subscription_status")
}

// =============================================================================
// Enums do motor de cadência (M10#1 SQL, M10#3 Prisma sync)
// =============================================================================

/// Status da cadência. `archived` reservado pra V2 quando "deletar" virar
/// soft-delete (M10#3 ainda usa CASCADE hard delete na action).
enum CadenceStatus {
  active
  paused
  archived

  @@map("cadence_status")
}

/// Canal de cada step. `email` está suportado no schema mas o runner M10#2
/// faz skip(`email_stub`) — Resend entra em milestone futuro.
enum CadenceStepChannel {
  whatsapp
  email

  @@map("cadence_step_channel")
}

/// Template de origem da cadência. `'alto-ticket'` (hífen) alinhado com
/// TEMPLATE_KEY_VALUES de `apps/web/features/cadences/schemas.ts` —
/// evita mapping em runtime na Server Action. Prisma aceita value com
/// hífen via `@map`; identifier TS vira `alto_ticket`.
enum CadenceTemplateKey {
  imobiliario
  b2b
  alto_ticket @map("alto-ticket")
  blank
  custom

  @@map("cadence_template_key")
}

/// Status da inscrição do lead numa cadência. `paused` exige `paused_reason`.
enum CadenceEnrollmentStatus {
  active
  paused
  completed
  cancelled

  @@map("cadence_enrollment_status")
}

/// Motivo da pausa (quando status='paused'). `lead_replied` é setado pelo
/// trigger `pause_cadence_on_inbound` (M10#1). `manual` é pausa via UI.
enum CadenceEnrollmentPauseReason {
  lead_replied
  manual
  stage_changed
  disconnected
  admin

  @@map("cadence_enrollment_pause_reason")
}

/// Status do step_run (uma execução de step pra enrollment). UNIQUE
/// (enrollment_id, step_id) do M10#1 garante max 1 row por par.
enum CadenceStepRunStatus {
  pending
  sent
  skipped
  failed

  @@map("cadence_step_run_status")
}

/// Razão do skip (quando status='skipped'). Mapeamento de anti-ban →
/// skip_reason está em `apps/web/features/cadences/dispatch/map-antiban-reason.ts`.
enum CadenceStepRunSkipReason {
  email_stub
  outside_business_hours
  blacklist
  rate_limit
  unhealthy
  no_phone
  lead_deleted
  workspace_paused

  @@map("cadence_step_run_skip_reason")
}

/// Temperatura térmica do lead (PRD §2.4). `cold` setado pelo
/// cold-lead-detector quando `last_interaction_at` ultrapassa threshold.
/// `'hot'` nunca degrada pra `'warm'` no trigger `pause_cadence_on_inbound`.
enum LeadTemperature {
  cold
  warm
  hot

  @@map("lead_temperature")
}

// =============================================================================
// Enums de domínio (M8#1)
// =============================================================================

/// Origem do lead — preenchida no create (manual, import CSV, webhook ads, etc.).
/// Espelha `apps/web/features/leads/types.ts:LeadOrigin` (9 valores). Em M9 a
/// origem `whatsapp_inbound` vira automática (lead criado quando chega mensagem
/// de número desconhecido); por enquanto entra manual ou via webhook.
enum LeadOrigin {
  site
  meta_ads
  google_ads
  indicacao
  whatsapp_inbound
  csv_import
  manual
  rd_station
  hotmart
  webhook_generico

  @@map("lead_origin")
}

/// Status do lead — `arquivado` é soft-archive (UI esconde de listas default);
/// `perdido`/`ganho` são terminais e fecham a relação. Soft-delete real (linha
/// some) usa `deletedAt`, separado do status (LGPD §17).
enum LeadStatus {
  ativo
  arquivado
  perdido
  ganho

  @@map("lead_status")
}

/// Status da oportunidade comercial. Lead pode ter múltiplos deals abertos
/// (clientes recorrentes, propostas paralelas) — `won/lost` fecha o deal,
/// não o lead. Espelha `apps/web/features/deals/types.ts:DealStatus`.
enum DealStatus {
  open
  won
  lost

  @@map("deal_status")
}

/// Tipo da tarefa — usado pra ícone na lista e pra agrupar relatórios.
enum TaskKind {
  call
  whatsapp
  email
  meeting
  follow_up
  other

  @@map("task_kind")
}

/// Status da tarefa. `snoozed` é "adia 1d/3d/7d" — UI esconde até o `dueAt`
/// novo. Diferente de `pending` pra distinguir adiada vs nunca-tocada.
enum TaskStatus {
  pending
  done
  snoozed

  @@map("task_status")
}

/// Tipo de evento na timeline do lead — append-only. Cada evento de domínio
/// (mover etapa, criar task, anexar arquivo) grava 1 linha em `activities`.
/// Mensagens WhatsApp (`whatsapp_in`/`whatsapp_out`) entram em M9 quando o
/// adapter conectar — entradas aqui são placeholder até lá.
enum ActivityType {
  whatsapp_in
  whatsapp_out
  call
  email
  meeting
  note
  task
  stage_change
  attachment
  lead_created

  @@map("activity_type")
}

/// Tom semântico da etapa pra UI — `success` em "Ganho", `destructive` em
/// "Perdido", `default` no resto. Persistido aqui pra que pipelines custom
/// (M8#2+) possam marcar suas próprias etapas terminais.
enum StageTone {
  default
  success
  destructive

  @@map("stage_tone")
}

/// Tipo do custom field. Schema cobre M8#1 já — UI de configuração entra
/// numa onda posterior (M8 polimento). `enum` armazena opções em `options`
/// JSONB do CustomField.
enum CustomFieldType {
  text
  number
  date
  enum

  @@map("custom_field_type")
}

// =============================================================================
// Enums de WhatsApp (M9#1)
// =============================================================================

/// Direção da mensagem em relação ao workspace.
///  - `out`: enviada pelo vendedor (vai pro lead)
///  - `in`: recebida do lead (chegou no número conectado)
/// Espelha `apps/web/features/inbox/types.ts:MessageDirection`.
enum MessageDirection {
  in
  out

  @@map("message_direction")
}

/// Tipos de mensagem suportados pelo WhatsApp. M9 entrega só `text` +
/// `internal_note`; mídia (`image`/`audio`/`document`) entra em M9.x/M10.
/// `internal_note` NÃO vai pro lead — visível só ao time (sempre out).
enum MessageKind {
  text
  image
  audio
  document
  internal_note

  @@map("message_kind")
}

/// Status agregado da conversa, denormalizado em `Conversation.status` pra
/// simplificar filtros sem indexar a última mensagem.
///  - `awaiting`: vendedor mandou e aguarda resposta
///  - `responded`: lead respondeu, vendedor precisa agir
///  - `archived`: conversa resolvida (PRD §3.8)
enum ConversationStatus {
  awaiting
  responded
  archived

  @@map("conversation_status")
}

/// Saúde da conexão WhatsApp do workspace (CLAUDE.md §9 Health Score).
///  - `healthy` (verde): tudo OK, envios autorizados
///  - `degraded` (amarelo): heartbeat oscilando
///  - `unhealthy` (vermelho): offline, envios pausados automaticamente
enum HealthScore {
  healthy
  degraded
  unhealthy

  @@map("health_score")
}

// =============================================================================
// Enums de Agentes IA + Cérebro da Empresa (M11#1)
// =============================================================================
//
// Espelham `apps/web/features/agents/types.ts` (UI mockada de M5 que vira
// contrato pro backend M11). Mudar shape aqui = retrabalho em cascata.

/// Status agregado do agente. `testing` é default ao criar — força revisão
/// antes de soltar o agente real (só responde no chat de simulação do editor).
enum AgentStatus {
  testing
  active
  paused

  @@map("agent_status")
}

/// Tons de voz pré-definidos. Lista fechada por design — tom livre demais gera
/// prompts inconsistentes e dificulta análise downstream.
enum AgentTone {
  consultivo
  amigavel
  direto
  formal

  @@map("agent_tone")
}

/// Tipos de regra de roteamento. Match no PRIMEIRO HIT ordenado por priority asc.
///  - `stage` → lead na etapa do funil X recebe este agente
///  - `tag` → lead com tag X recebe este agente
///  - `whatsapp_number` → leads que chegam pelo número conectado X
///  - `keyword` → lead falou a palavra-chave X na primeira mensagem
enum AgentRouteKind {
  stage
  tag
  whatsapp_number
  keyword

  @@map("agent_route_kind")
}

/// Tipo da sessão IA:
///  - `production` → atende lead real, toca conversation/lead, alimenta
///    métricas, dispara handoff
///  - `simulation` → chat de teste no editor, sem efeito colateral
enum AgentSessionKind {
  production
  simulation

  @@map("agent_session_kind")
}

/// Discriminador de chunk do Cérebro da Empresa:
///  - `structured_field` → vem dos 5 campos (about/products/faq/scripts/policy)
///  - `document` → vem de chunking de um knowledge_document uploadado
enum KnowledgeSourceKind {
  structured_field
  document

  @@map("knowledge_source_kind")
}

/// Status do processing pipeline do documento. `uploading` = arquivo no
/// Storage mas extração ainda não rodou; `processed` = chunks+embeddings
/// persistidos, RAG pode usar.
enum KnowledgeDocStatus {
  uploading
  processing
  processed
  failed

  @@map("knowledge_doc_status")
}

/// Tipos de arquivo suportados pelo Cérebro (M5 cobre 3, M11 expande pra 5).
enum KnowledgeDocKind {
  pdf
  doc
  docx
  txt
  md

  @@map("knowledge_doc_kind")
}

/// Tipo de evento de uso de IA (M11#2). Free-form `feature` na tabela
/// `usage_events` permite mais granularidade sem migration.
///  - `agent_call`     → chamada Claude messages.create (agente respondendo)
///  - `embedding_call` → chamada OpenAI embeddings (indexação do Cérebro)
///  - `summary_call`   → chamada Claude pra atualizar lead_summary (background)
enum UsageEventKind {
  agent_call
  embedding_call
  summary_call

  @@map("usage_event_kind")
}

// =============================================================================
// Tenant + identidade
// =============================================================================

/// Tenant isolado. Toda tabela de domínio referencia workspaces.id.
model Workspace {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(60)
  slug      String    @unique @db.VarChar(80)
  logoUrl   String?   @map("logo_url")
  segment   String?   @db.VarChar(32)
  plan      String    @default("Pro") @db.VarChar(32)
  timezone  String    @default("America/Sao_Paulo") @db.VarChar(64)
  locale    String    @default("pt-BR") @db.VarChar(8)
  settings  Json      @default("{}")
  /// Token URL-safe para o endpoint `POST /api/webhooks/leads/[token]` (M8#5).
  /// Gerado via `randomBytes(32).toString('base64url')` no `createWorkspaceAction`
  /// e regenerável por Owner/Admin em Settings → Connections. Unique pra que
  /// o lookup do route handler seja O(log n) e nunca colida entre workspaces.
  webhookToken String?  @unique @map("webhook_token") @db.VarChar(64)
  /// Trial 7d sem cartão (M12#2). `createdAt + 7d`, setado no
  /// `createWorkspaceAction`. NULL = workspace sem trial. Expiração é lazy —
  /// `getActivePlan` compara `NOW() < trialEndsAt` ao vivo.
  trialEndsAt       DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  /// Idempotência dos avisos D-2/D-1 disparados pelo job `/api/cron/trial-warnings`.
  trialWarnD2SentAt DateTime? @map("trial_warn_d2_sent_at") @db.Timestamptz(6)
  trialWarnD1SentAt DateTime? @map("trial_warn_d1_sent_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  members                 WorkspaceMember[]
  invitations             Invitation[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
  webhookEvents           WebhookEvent[]
  stripeCustomer          StripeCustomer?
  subscriptions           Subscription[]
  pipelines               Pipeline[]
  leads                   Lead[]
  deals                   Deal[]
  tags                    Tag[]
  tasks                   Task[]
  activities              Activity[]
  attachments             Attachment[]
  customFields            CustomField[]
  whatsappAccount         WhatsappAccount?
  whatsappInstances       WhatsappInstance[]
  conversations           Conversation[]
  messages                Message[]
  quickReplies            QuickReply[]
  blacklist               BlackList[]
  whatsappEvents          WhatsappEvent[]
  cadences                Cadence[]
  cadenceEnrollments      CadenceEnrollment[]
  cadenceStepRuns         CadenceStepRun[]
  coldLeadThresholds      ColdLeadThreshold[]
  coldLeadAlerts          ColdLeadAlert[]
  aiAgents                AiAgent[]
  agentSessions           AgentSession[]
  agentMessages           AgentMessage[]
  leadSummaries           LeadSummary[]
  knowledgeBaseField      KnowledgeBaseField?
  knowledgeDocuments      KnowledgeDocument[]
  knowledgeChunks         KnowledgeChunk[]
  knowledgeEmbeddings     KnowledgeEmbedding[]
  usageEvents             UsageEvent[]

  @@index([deletedAt])
  @@map("workspaces")
}

/// Espelha auth.users via trigger on_auth_user_created.
/// Não inserir diretamente — Supabase Auth gerencia. id é o mesmo UUID de auth.users.id.
///
/// **Invariante de `email` (M7#5 HIGH #11):** a coluna é `@db.Citext` —
/// comparação case-insensitive *no Postgres*. Mas o Prisma client recebe e
/// retorna o valor literal como veio, sem normalizar. Toda escrita no app
/// (signup, upsert defensivo em workspace/invitations actions) deve passar
/// por `.toLowerCase().trim()` antes — caso contrário, dois "Foo@bar.com" e
/// "foo@bar.com" produzem 1 linha em SELECT (citext) mas o cache da app vê
/// strings diferentes em dois callsites. Convenção: normalizar na borda
/// (Server Action), confiar no tipo internamente.
model User {
  id              String    @id @db.Uuid
  email           String    @unique @db.Citext
  name            String?   @db.VarChar(120)
  avatarUrl       String?   @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships             WorkspaceMember[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
  invitationsCreated      Invitation[]             @relation("InvitationCreatedBy")
  attachmentsUploaded     Attachment[]             @relation("AttachmentUploadedBy")
  cadencesCreated         Cadence[]                @relation("CadenceCreatedBy")
  coldLeadAlertsAcked     ColdLeadAlert[]          @relation("ColdLeadAlertAckedBy")
  aiAgentsCreated         AiAgent[]                @relation("AiAgentCreatedBy")
  agentVersionsCreated    AgentVersion[]           @relation("AgentVersionCreatedBy")
  knowledgeDocsUploaded   KnowledgeDocument[]      @relation("KnowledgeDocumentUploadedBy")

  @@map("users")
}

/// Relação usuário ↔ workspace com papel RBAC.
model WorkspaceMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        Role
  invitedAt   DateTime? @map("invited_at") @db.Timestamptz(6)
  joinedAt    DateTime? @map("joined_at") @db.Timestamptz(6)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  leadsAssigned         Lead[]         @relation("LeadAssignee")
  dealsOwned            Deal[]         @relation("DealOwner")
  tasksAssigned         Task[]         @relation("TaskAssignee")
  activitiesAuthor      Activity[]     @relation("ActivityAuthor")
  conversationsAsVendor Conversation[] @relation("ConversationVendor")
  messagesAuthored      Message[]      @relation("MessageAuthor")

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

/// Convite por email com magic link. TTL 7 dias (gerenciado no app).
model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  email       String           @db.Citext
  role        Role
  token       String           @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  status      InvitationStatus @default(pending)
  createdById String           @map("created_by_id") @db.Uuid
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([token])
  @@map("invitations")
}

// =============================================================================
// Auditoria + preferências + webhooks
// =============================================================================

/// Log de auditoria (LGPD). Append-only — nenhuma policy de UPDATE/DELETE.
/// Cleanup futuro via pg_cron com retenção 12m (Pro) / 24m (Enterprise).
model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  action      AuditAction
  entityType  String?     @map("entity_type") @db.VarChar(64)
  entityId    String?     @map("entity_id") @db.VarChar(64)
  changes     Json?
  ipAddress   String?     @map("ip_address") @db.Inet
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, userId])
  @@map("audit_logs")
}

/// Preferências de notificação por (workspace, user). JSONB wide.
/// Eventos administrativos (workspace_invite_received, payment_failed) NÃO ficam aqui
/// — são forçados na camada de envio (PRD §3.2 "não podem ser desligados").
model NotificationPreference {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  prefs       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("notification_preferences")
}

/// Assinatura de Web Push por dispositivo/browser (M13#2). Guarda o
/// `PushSubscription` (endpoint + chaves p256dh/auth) que o web-push usa pra
/// entregar a notificação criptografada (RFC 8291). `endpoint` é UNIQUE
/// global — re-assinar o mesmo browser cai em UPSERT (re-atribui userId).
model PushSubscription {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@map("push_subscriptions")
}

/// Feed de notificações in-app (M13#2 — PRD §3.2 sino com histórico de 30d).
/// Escrito pelo dispatcher (canal `inapp`), lido pelo sino do topbar.
/// `readAt` é o único campo mutável. `event` é a chave da matriz (texto livre
/// — não enum, pra não exigir migration por evento novo).
model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  event       String    @db.VarChar(48)
  title       String
  body        String
  url         String?
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Idempotência de webhooks externos. (source, externalId) único.
/// Append-only — nenhuma policy de UPDATE/DELETE.
model WebhookEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  source         String    @db.VarChar(32)
  externalId     String    @map("external_id") @db.VarChar(128)
  payload        Json
  signatureValid Boolean   @default(false) @map("signature_valid")
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([workspaceId, source, createdAt(sort: Desc)])
  @@map("webhook_events")
}

/// Mapeia workspace ↔ customer no Stripe (M12#1). 1:1 — workspace tem um
/// customer só; customer pertence a um workspace só. `workspace_id` é PK
/// porque a unicidade é por workspace (não há sentido em ter 2 customers).
///
/// **Fluxo:** `createCheckoutSessionAction` faz `getOrCreate` — primeiro
/// upgrade cria o customer no Stripe + grava aqui; upgrades subsequentes
/// reusam o `stripe_customer_id` existente (evita customer-órfão no Stripe).
model StripeCustomer {
  workspaceId      String   @id @map("workspace_id") @db.Uuid
  stripeCustomerId String   @unique @map("stripe_customer_id") @db.VarChar(255)
  email            String?  @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@map("stripe_customers")
}

/// Subscription Stripe ativa/histórica do workspace (M12#1). 1:N — workspace
/// pode acumular várias rows ao longo do tempo (cada upgrade/downgrade cria
/// uma; cancelamentos preservam a row pra audit). "Plano atual" = row com
/// `status='active'` (ou `past_due`); ausência = workspace está no plano free.
///
/// `stripe_subscription_id UNIQUE` garante idempotência ao reagir a múltiplos
/// `customer.subscription.created` (Stripe at-least-once). Webhook handler
/// faz `upsert` por esse campo.
model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String             @map("workspace_id") @db.Uuid
  stripeSubscriptionId String             @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripeCustomerId     String             @map("stripe_customer_id") @db.VarChar(255)
  priceId              String             @map("price_id") @db.VarChar(255)
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  currentPeriodStart   DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime           @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// =============================================================================
// Domínio CRM (M8#1)
// =============================================================================

/// Funil de vendas. Cada workspace tem 1+ pipelines; um é `isDefault=true` e
/// `createWorkspaceAction` semeia 6 etapas padrão (Novo → … → Ganho/Perdido).
/// Custom pipelines (M8#2+) podem ter qualquer número de etapas com `order`
/// definido pelo Owner/Admin.
///
/// **Soft-delete:** `deletedAt` esconde da UI mas mantém histórico — leads e
/// deals que referenciavam etapas dessa pipeline continuam válidos (FK Restrict
/// nas etapas garante que pipeline com tráfego não some).
model Pipeline {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String    @db.VarChar(80)
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]

  @@index([workspaceId])
  @@index([workspaceId, isDefault])
  @@map("pipelines")
}

/// Etapa do funil. `order` define a sequência visual no Kanban (1-indexed,
/// crescente da esquerda pra direita). `rotDays` é o número de dias após os
/// quais um deal "esfria" nessa etapa — usado pelo detector de lead frio (M10).
/// `terminal=true` impede cadências (M10) de re-engajar e marca a etapa como
/// final no funil (Ganho/Perdido).
///
/// **Slug** é estável e único por pipeline — usado nas FKs de leads/deals em
/// vez do UUID pra que a UI possa fazer `where: { stageId: 'novo' }` sem
/// lookup. O ID UUID é a verdadeira PK; o slug é só conveniência de API.
model PipelineStage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId String    @map("pipeline_id") @db.Uuid
  slug       String    @db.VarChar(64)
  name       String    @db.VarChar(80)
  order      Int
  rotDays    Int       @default(0) @map("rot_days")
  terminal   Boolean   @default(false)
  tone       StageTone @default(default)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pipeline           Pipeline            @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads              Lead[]
  deals              Deal[]
  cadences           Cadence[]
  coldLeadThresholds ColdLeadThreshold[]

  @@unique([pipelineId, slug])
  @@unique([pipelineId, order])
  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

/// Contato cru — pessoa/empresa com potencial de virar oportunidade. Em
/// imobiliário/B2B/alto-ticket (beachhead PapoPro), um lead pode gerar 0..N
/// deals ao longo do tempo (compra de imóvel A, recompra de imóvel B etc.).
///
/// **`temperature` é persistida desde M10#1** (substitui a derivação prévia).
/// Default `warm` no signup/import. Trigger `pause_cadence_on_inbound` (M10#1)
/// re-aquece `cold → warm` quando o lead responde, mas NÃO degrada `'hot'`
/// pra `'warm'` (sinal explícito de alta intenção). O cold-lead-detector
/// (M10#4) seta `cold` quando `last_interaction_at` ultrapassa threshold da
/// etapa em `cold_lead_thresholds`.
///
/// **`stageId`** referencia a "etapa principal" do lead (pra UI de lista densa
/// mostrar). O estado canônico da oportunidade vive em `Deal.stageId` — Kanban
/// lê de lá, não daqui.
model Lead {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  name              String          @db.VarChar(120)
  email             String?         @db.Citext
  phone             String          @db.VarChar(32)
  company           String?         @db.VarChar(120)
  position          String?         @db.VarChar(80)
  origin            LeadOrigin      @default(manual)
  status            LeadStatus      @default(ativo)
  stageId           String          @map("stage_id") @db.Uuid
  assignedToId      String          @map("assigned_to_id") @db.Uuid
  valueCents        Int             @default(0) @map("value_cents")
  notes             String?
  /// Temperatura térmica do lead (M10#1). Default `warm` no insert.
  temperature       LeadTemperature @default(warm)
  /// Último timestamp em que o cold-lead-detector (M10#4) sinalizou esse
  /// lead como frio. Resetado pra `null` pelo trigger M10#1 quando o lead
  /// responde. Evita realertar em loop.
  coldAlertedAt     DateTime?       @map("cold_alerted_at") @db.Timestamptz(6)
  lastInteractionAt DateTime?       @map("last_interaction_at") @db.Timestamptz(6)
  nextActionAt      DateTime?       @map("next_action_at") @db.Timestamptz(6)
  nextActionLabel   String?         @map("next_action_label") @db.VarChar(120)
  createdById       String?         @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage              PipelineStage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  assignedTo         WorkspaceMember      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  deals              Deal[]
  tasks              Task[]
  activities         Activity[]
  attachments        Attachment[]
  tags               LeadTag[]
  customValues       LeadCustomValue[]
  conversations      Conversation[]
  cadenceEnrollments CadenceEnrollment[]
  coldLeadAlerts     ColdLeadAlert[]
  summary            LeadSummary?
  agentSessions      AgentSession[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([workspaceId, stageId])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, lastInteractionAt(sort: Desc)])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, temperature])
  @@map("leads")
}

/// Oportunidade comercial — `(leadId, stageId)` representa "lead X está na
/// etapa Y do funil Z com valor V". Lead pode ter múltiplos deals abertos:
/// imóvel A em "Negociação" + imóvel B em "Proposta". O Kanban lê desta tabela.
///
/// **Soft-archive via `status`**, soft-delete via `deletedAt`. Diferente:
/// `status=lost` registra perda com `lostReason`; `deletedAt` é "remover por
/// erro de digitação" (raro mas LGPD §17 exige).
model Deal {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  title        String     @db.VarChar(160)
  leadId       String     @map("lead_id") @db.Uuid
  stageId      String     @map("stage_id") @db.Uuid
  valueCents   Int        @default(0) @map("value_cents")
  ownerId      String     @map("owner_id") @db.Uuid
  probability  Int?
  dueAt        DateTime?  @map("due_at") @db.Timestamptz(6)
  description  String?
  status       DealStatus @default(open)
  lostReason   String?    @map("lost_reason")
  orderInStage Int        @default(0) @map("order_in_stage")
  closedAt     DateTime?  @map("closed_at") @db.Timestamptz(6)
  createdById  String?    @map("created_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage     PipelineStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner     WorkspaceMember @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([workspaceId, stageId, orderInStage])
  @@index([workspaceId, status])
  @@index([workspaceId, ownerId])
  @@index([leadId])
  @@index([workspaceId, deletedAt])
  @@map("deals")
}

/// Tag livre — criada inline no form de lead. Por workspace, unique por nome
/// (case-insensitive via citext). UI permite até 8 por lead (enforced no app).
model Tag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.Citext
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadTags  LeadTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("tags")
}

/// Junction lead ↔ tag (m:n).
model LeadTag {
  leadId    String   @map("lead_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
  @@map("lead_tags")
}

/// Tarefa vinculada a um lead. `kind` é só ícone/agrupamento de relatório;
/// `dueAt` é o que dispara a coluna "atrasadas" no /tasks. `snoozed` é estado
/// intermediário entre `pending` e `done` — adiada por N dias, some da UI até
/// o `dueAt` novo.
model Task {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  leadId       String     @map("lead_id") @db.Uuid
  kind         TaskKind
  title        String     @db.VarChar(160)
  notes        String?
  dueAt        DateTime   @map("due_at") @db.Timestamptz(6)
  status       TaskStatus @default(pending)
  assignedToId String     @map("assigned_to_id") @db.Uuid
  doneAt       DateTime?  @map("done_at") @db.Timestamptz(6)
  createdById  String?    @map("created_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo WorkspaceMember @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, assignedToId])
  @@index([leadId])
  @@map("tasks")
}

/// Timeline append-only do lead. Cada evento de domínio (mudança de etapa,
/// criar task, anexar arquivo, mensagem WhatsApp em M9) grava 1 linha aqui.
/// **Sem update/delete** — policy RLS proíbe; LGPD permite anonimização via
/// reescrita de `body` se solicitado.
///
/// `authorId` opcional pra eventos de sistema (`stage_change` automático por
/// cadência, por exemplo). `meta` JSONB carrega contexto específico do tipo
/// (fromStageId/toStageId em stage_change, durationSeconds em call, etc.).
model Activity {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  leadId      String       @map("lead_id") @db.Uuid
  type        ActivityType
  body        String?
  authorId    String?      @map("author_id") @db.Uuid
  meta        Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    WorkspaceMember? @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, leadId, createdAt(sort: Desc)])
  @@index([leadId, createdAt(sort: Desc)])
  @@index([workspaceId, type])
  @@map("activities")
}

/// Anexo de lead — arquivo armazenado no Supabase Storage bucket `attachments`.
/// `path` é o storage path completo (`<workspaceId>/<leadId>/<uuid>-<filename>`);
/// `bucket` permite migrar pra outro bucket no futuro sem alterar schema.
///
/// **Cleanup de órfãos:** `pg_cron` diário em M8#6 vai varrer linhas com
/// `deletedAt > 30 dias` e apagar o objeto no Storage. Até lá, soft-delete só
/// esconde da UI.
model Attachment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  bucket       String    @default("attachments") @db.VarChar(64)
  path         String
  fileName     String    @map("file_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(127)
  sizeBytes    Int       @map("size_bytes")
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, leadId, createdAt(sort: Desc)])
  @@index([workspaceId, deletedAt])
  @@map("attachments")
}

/// Campo customizado por workspace — Owner/Admin define no settings o que
/// quer rastrear além dos campos default (ex: "metragem", "andar", "ICP score").
/// Schema preparado em M8#1; UI de gestão entra numa onda posterior.
model CustomField {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  key         String          @db.VarChar(64)
  label       String          @db.VarChar(120)
  type        CustomFieldType
  options     Json?
  order       Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    LeadCustomValue[]

  @@unique([workspaceId, key])
  @@index([workspaceId, order])
  @@map("custom_fields")
}

/// Valor do custom field pra um lead específico — JSONB porque o tipo varia
/// (text/number/date/enum). Trade-off conhecido: queries em valores custom
/// usam GIN sobre `value` em vez de índices nativos; performance OK pra
/// volume MVP, revisamos se virar gargalo.
model LeadCustomValue {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId        String   @map("lead_id") @db.Uuid
  customFieldId String   @map("custom_field_id") @db.Uuid
  value         Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, customFieldId])
  @@index([customFieldId])
  @@map("lead_custom_values")
}

// =============================================================================
// WhatsApp (M9#1)
// =============================================================================
//
// Schema preparado em M9#1 (sem actions/webhook/heartbeat ainda — esses entram
// em M9#2..M9#5). Espelha o contrato fechado em `apps/web/features/inbox/types.ts`
// e `apps/web/features/inbox/schemas.ts`. Decisões fechadas:
//   - 1 número por workspace (Workspace 1—1 WhatsappAccount).
//   - MVP só `text` + `internal_note` (mídia em M9.x/M10).
//   - Lead inbound desconhecido vira lead automático com round-robin (M9#3).
//   - Opt-out `^(pare|sair|cancelar)$` → BlackList (M9#3).

/// Conta WhatsApp do workspace — 1:1 com Workspace. Cobre o número conectado
/// via uazapi (Standard, Pro/Pro IA). Cloud API Meta (Enterprise, V2) entra
/// pelo mesmo modelo, só varia `provider`.
///
/// **`phoneNumber`** é a referência humana — gravada quando a sessão fica
/// `connected` pela primeira vez (uazapi expõe via `getInstanceStatus`). Antes
/// disso fica vazio mas o registro existe pra ancorar a `WhatsappInstance`.
model WhatsappAccount {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  phoneNumber String   @default("") @map("phone_number") @db.VarChar(32)
  displayName String?  @map("display_name") @db.VarChar(120)
  provider    String   @default("uazapi") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instance      WhatsappInstance?
  conversations Conversation[]

  @@map("whatsapp_accounts")
}

/// Sessão atual da conta WhatsApp — armazena estado dinâmico (status, QR code,
/// health, anti-ban). Separado de `WhatsappAccount` porque a conta é estável
/// (1 número por workspace) mas a sessão pode ser reiniciada (regenerar QR,
/// reconectar) sem perder o histórico de mensagens vinculadas à conta.
///
/// **`status`** intencionalmente string (não enum): a evolução de estados
/// uazapi/cloud é frequente (`connecting`/`pairing`/`connected`/`disconnected`/
/// `banned`/...) e enum exigiria migration por valor. Validação aplicada na
/// borda via Zod no M9#2.
///
/// **`messagesSent24h`** + **`pausedUntil`**: ganchos do anti-ban (M9#3). O
/// detector de health score (M9#5) decide quando pausar baseado em queda de
/// heartbeat ou ratio de bloqueios.
model WhatsappInstance {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String      @map("workspace_id") @db.Uuid
  accountId           String      @unique @map("account_id") @db.Uuid
  externalInstanceId  String?     @map("external_instance_id") @db.VarChar(128)
  status              String      @default("disconnected") @db.VarChar(24)
  healthScore         HealthScore @default(healthy) @map("health_score")
  qrCode              String?     @map("qr_code")
  qrExpiresAt         DateTime?   @map("qr_expires_at") @db.Timestamptz(6)
  lastSeenAt          DateTime?   @map("last_seen_at") @db.Timestamptz(6)
  connectedAt         DateTime?   @map("connected_at") @db.Timestamptz(6)
  disconnectedAt      DateTime?   @map("disconnected_at") @db.Timestamptz(6)
  messagesSent24h     Int         @default(0) @map("messages_sent_24h")
  pausedUntil         DateTime?   @map("paused_until") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([lastSeenAt])
  @@map("whatsapp_instances")
}

/// Conversa entre o número do workspace e um contato. Espelha
/// `features/inbox/types.ts:Conversation`. **Unique por `(workspaceId,
/// contactPhone)`** porque só temos 1 número por workspace (decisão M9 fechada),
/// então cada telefone gera 1 conversa contínua.
///
/// **`status`** é denormalizado (não derivado) — facilita filtros sem indexar
/// a última mensagem. Atualizado nas mutations (`sendText` → awaiting, inbound
/// → responded, `archive` → archived).
///
/// **`lastMessagePreview`** + **`lastMessageDirection`** + **`lastMessageAt`**
/// denormalizados pra que a lista de conversas (sidebar Inbox) não precise de
/// subquery `ORDER BY messages.created_at DESC LIMIT 1` por linha. Renderização
/// O(1) em workspaces com 1000+ conversas.
model Conversation {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String              @map("workspace_id") @db.Uuid
  leadId               String              @map("lead_id") @db.Uuid
  vendorId             String?             @map("vendor_id") @db.Uuid
  whatsappAccountId    String              @map("whatsapp_account_id") @db.Uuid
  contactPhone         String              @map("contact_phone") @db.VarChar(32)
  status               ConversationStatus  @default(awaiting)
  lastMessageAt        DateTime?           @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview   String?             @map("last_message_preview") @db.VarChar(280)
  lastMessageDirection MessageDirection?   @map("last_message_direction")
  unreadCount          Int                 @default(0) @map("unread_count")
  /// M11#6 — false = handoff agente→humano disparado; roteador pula a conversa
  /// até "Devolver pra IA". true (default) = IA pode atender.
  aiEnabled            Boolean             @default(true) @map("ai_enabled")
  archivedAt           DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead             Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendor           WorkspaceMember? @relation("ConversationVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  whatsappAccount  WhatsappAccount  @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  messages         Message[]
  agentSessions    AgentSession[]

  @@unique([workspaceId, contactPhone])
  @@index([workspaceId, status, lastMessageAt(sort: Desc)])
  @@index([workspaceId, vendorId])
  @@index([leadId])
  @@map("conversations")
}

/// Mensagem trocada na conversa. Append-only (sem update do body / direction /
/// kind — só `readAt` e `deliveredAt` mudam após criação). Espelha
/// `features/inbox/types.ts:Message`.
///
/// **`externalMessageId`** é o ID do provedor (uazapi `message_id`). Usado pra
/// idempotência inbound — webhook recebe múltiplas entregas do mesmo evento e
/// dedupa por `(workspaceId, externalMessageId)`. Como é nullable (mensagens
/// outbound geradas antes de receber ACK podem ainda não ter ID), o unique é
/// **partial** (`WHERE external_message_id IS NOT NULL`) declarado no SQL
/// manual — Prisma 5 não suporta `WHERE` em `@@unique`. Aqui só o índice.
///
/// **`authorId`** null para inbound (`direction='in'`). Outbound sempre tem
/// autor (vendedor humano ou agente IA em M11).
model Message {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String           @map("workspace_id") @db.Uuid
  conversationId       String           @map("conversation_id") @db.Uuid
  kind                 MessageKind
  direction            MessageDirection
  body                 String?
  authorId             String?          @map("author_id") @db.Uuid
  externalMessageId    String?          @map("external_message_id") @db.VarChar(128)
  deliveredAt          DateTime?        @map("delivered_at") @db.Timestamptz(6)
  readAt               DateTime?        @map("read_at") @db.Timestamptz(6)
  mediaName            String?          @map("media_name") @db.VarChar(255)
  mediaSizeKb          Int?             @map("media_size_kb")
  mediaDurationSeconds Int?             @map("media_duration_seconds")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author          WorkspaceMember? @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  cadenceStepRuns CadenceStepRun[]

  @@index([workspaceId, conversationId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([workspaceId, externalMessageId])
  @@map("messages")
}

/// Template de resposta rápida do composer da Inbox (PRD §3.8). Por workspace,
/// unique por `label` pra evitar chips duplicados na barra. `body` pode conter
/// placeholders `{nome}` / `{empresa}` / `{produto}` resolvidos contra o lead
/// da conversa atual no client.
model QuickReply {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  label       String   @db.VarChar(80)
  body        String
  order       Int      @default(0)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label])
  @@index([workspaceId, order])
  @@map("quick_replies")
}

/// Opt-out LGPD (CLAUDE.md §7.5). Detecção automática via regex
/// `^(pare|sair|cancelar)$` no webhook inbound (M9#3) insere row aqui +
/// activity `opt_out` no lead + audit `whatsapp_blocked_optout`. Anti-ban
/// (`lib/whatsapp/anti-ban.ts` M9#3) consulta `(workspaceId, phone)` antes de
/// liberar qualquer envio. `reason` permite distinguir opt-out automático
/// de bloqueio manual ou marcação de spam.
model BlackList {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  phone       String   @db.VarChar(32)
  reason      String   @default("opt_out") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@map("blacklist")
}

/// Eventos da sessão WhatsApp — separado de `WebhookEvent` (M7#2/M8#5) que é
/// genérico por `(source, externalId)`. Aqui armazenamos eventos
/// específicos do ciclo de vida da conexão (connected/disconnected/qr_refreshed/
/// heartbeat_ok/heartbeat_fail) pra observability + debug. Append-only.
model WhatsappEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  instanceId  String?  @map("instance_id") @db.Uuid
  type        String   @db.VarChar(32)
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([instanceId, type, createdAt(sort: Desc)])
  @@map("whatsapp_events")
}

// =============================================================================
// Cadências e Lead Frio (M10#1 SQL, M10#3 Prisma sync)
// =============================================================================

/// Cadência de follow-up automatizado vinculada a uma etapa do pipeline.
/// Quando ativa, um Server Action (M10#3 `enrollLeadAction`) inscreve leads
/// e o motor (M10#2 Edge Function + dispatch route) processa step-by-step
/// segundo o `day_offset` de cada `CadenceStep`.
///
/// **Status** lifecycle: `active` (motor processa) ↔ `paused` (motor ignora).
/// `archived` reservado pra V2 (soft-delete). DELETE hard hoje cascateia.
///
/// **Template seedado** ao criar workspace (M10#1 backfill + M10#3 signup):
/// 3 cadências paused (Imobiliário/B2B/Alto Ticket) com 17 steps total.
model Cadence {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  stageId      String             @map("stage_id") @db.Uuid
  name         String             @db.VarChar(120)
  description  String?            @db.VarChar(280)
  templateKey  CadenceTemplateKey @default(custom) @map("template_key")
  status       CadenceStatus      @default(active)
  createdById  String?            @map("created_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage       PipelineStage       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  createdBy   User?               @relation("CadenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  steps       CadenceStep[]
  enrollments CadenceEnrollment[]

  @@index([workspaceId])
  @@index([workspaceId, stageId])
  @@index([workspaceId, status])
  @@map("cadences")
}

/// Step individual de cadência — corpo da mensagem + canal + day_offset.
///
/// **`dayOffset`** restrito a {0, 1, 3, 7, 14, 30} via CHECK constraint
/// (M10#1 SQL). `order_index` permite múltiplos steps no mesmo dia.
///
/// **`templateBody`** suporta placeholders `{nome}`/`{empresa}`/`{produto}`
/// resolvidos pelo `resolvePlaceholders` (features/inbox/transforms.ts)
/// dentro da rota dispatch M10#2 antes de chamar o adapter uazapi.
model CadenceStep {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cadenceId    String             @map("cadence_id") @db.Uuid
  dayOffset    Int                @map("day_offset")
  channel      CadenceStepChannel
  templateBody String             @map("template_body")
  orderIndex   Int                @default(0) @map("order_index")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cadence  Cadence          @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  stepRuns CadenceStepRun[]

  @@unique([cadenceId, dayOffset, orderIndex])
  @@index([cadenceId, dayOffset, orderIndex])
  @@map("cadence_steps")
}

/// Inscrição de um lead numa cadência. Único por `(cadence_id, lead_id)`.
///
/// **`nextRunAt`** é o quando o motor (M10#2 RPC `cadence_runner_pick_candidates`)
/// considera elegível. Avançado pelo dispatch route após cada step (absoluto:
/// `enrolled_at + day_offset * day`). Backoff transiente seta `NOW() + 30min`.
///
/// **`pausedReason`** é populado quando `status='paused'`:
///   - `lead_replied` (trigger M10#1 `pause_cadence_on_inbound`)
///   - `manual` (pausa via UI no detalhe do lead)
///   - `stage_changed` / `disconnected` / `admin` (reservados pra M10#4+)
model CadenceEnrollment {
  id           String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String                        @map("workspace_id") @db.Uuid
  cadenceId    String                        @map("cadence_id") @db.Uuid
  leadId       String                        @map("lead_id") @db.Uuid
  status       CadenceEnrollmentStatus       @default(active)
  pausedReason CadenceEnrollmentPauseReason? @map("paused_reason")
  enrolledAt   DateTime                      @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  pausedAt     DateTime?                     @map("paused_at") @db.Timestamptz(6)
  completedAt  DateTime?                     @map("completed_at") @db.Timestamptz(6)
  nextRunAt    DateTime                      @default(now()) @map("next_run_at") @db.Timestamptz(6)
  createdAt    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cadence   Cadence          @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepRuns  CadenceStepRun[]

  @@unique([cadenceId, leadId])
  @@index([workspaceId, status])
  @@index([status, nextRunAt])
  @@index([leadId])
  @@index([cadenceId])
  @@map("cadence_enrollments")
}

/// Execução de um step pra uma enrollment. UNIQUE `(enrollment_id, step_id)`
/// é o que garante idempotência forte do motor — duas invocações concorrentes
/// do `cadence-runner` (M10#2) tentam INSERT, a segunda perde.
///
/// **`status`** progride pending → sent | skipped | failed. A RPC
/// `cadence_runner_pick_candidates` (M10#2) trata QUALQUER status como
/// "executado" via LEFT JOIN — retry do mesmo step em transient skip exige
/// DELETE da row antes (adiado pra M10.x).
///
/// **`messageId`** populado no happy path (apontando pra Message criada pela
/// rota dispatch). Null em skip/failed.
model CadenceStepRun {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String                    @map("workspace_id") @db.Uuid
  enrollmentId  String                    @map("enrollment_id") @db.Uuid
  stepId        String                    @map("step_id") @db.Uuid
  status        CadenceStepRunStatus      @default(pending)
  skipReason    CadenceStepRunSkipReason? @map("skip_reason")
  errorDetail   String?                   @map("error_detail")
  scheduledFor  DateTime                  @map("scheduled_for") @db.Timestamptz(6)
  executedAt    DateTime?                 @map("executed_at") @db.Timestamptz(6)
  messageId     String?                   @map("message_id") @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollment CadenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       CadenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  message    Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, stepId])
  @@index([workspaceId, status])
  @@index([enrollmentId])
  @@map("cadence_step_runs")
}

/// Threshold de inatividade por etapa do funil (PRD §2.2). 5 thresholds
/// seedados por workspace (M10#1 backfill): 7d Novo, 14d Em Contato, 7d
/// Proposta, 5d Negociação, 30d Global (`stage_id IS NULL`).
///
/// **`stageId nullable`** — NULL representa fallback global do workspace.
/// UNIQUE NULLS NOT DISTINCT (Postgres 15+) garante unique mesmo com NULL.
///
/// **`enabled`** permite desativar threshold individual sem deletar (Settings UI).
model ColdLeadThreshold {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  stageId      String?  @map("stage_id") @db.Uuid
  daysInactive Int      @map("days_inactive")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage     PipelineStage?  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  alerts    ColdLeadAlert[]

  @@unique([workspaceId, stageId], name: "cold_lead_thresholds_unique_stage")
  @@index([workspaceId])
  @@map("cold_lead_thresholds")
}

/// Alerta de lead frio disparado pelo cold-lead-detector (M10#4 — pendente).
/// UNIQUE `(lead_id, threshold_id)` evita realertar mesmo threshold/lead.
///
/// **`acknowledgedAt`** marca quando vendedor/gestor reconheceu via UI
/// (clica em "Marcar como visto"). `null` = alerta ainda novo no dashboard.
model ColdLeadAlert {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  thresholdId      String    @map("threshold_id") @db.Uuid
  triggeredAt      DateTime  @default(now()) @map("triggered_at") @db.Timestamptz(6)
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead           Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  threshold      ColdLeadThreshold @relation(fields: [thresholdId], references: [id], onDelete: Cascade)
  acknowledgedBy User?             @relation("ColdLeadAlertAckedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@unique([leadId, thresholdId])
  @@index([workspaceId, acknowledgedAt])
  @@index([leadId])
  @@map("cold_lead_alerts")
}

// =============================================================================
// Agentes IA + Cérebro da Empresa (M11#1)
// =============================================================================
//
// Espelham `apps/web/features/agents/types.ts` (UI mockada de M5 que vira
// contrato pro backend M11). M11#1 entrega só schema + RLS + smoke; UI
// conecta em M11#3 via Server Actions.
//
// Memória 3 camadas (CLAUDE.md §6):
//   - SESSÃO = AgentMessage (isolada por agente)
//   - LEAD   = LeadSummary (compartilhado entre agentes do workspace)
//   - EMPRESA = KnowledgeBaseField + KnowledgeDocument + KnowledgeChunk
//               + KnowledgeEmbedding (compartilhado por todos; pgvector top-K)

/// Persona configurável do agente. `prompt`/`persona`/`tone` representam o
/// DRAFT atual (editado no editor, ainda não-versionado). `activeVersionId`
/// aponta pra versão "em produção" (a que o runtime usa ao iniciar sessão
/// real). Restore de versão antiga = copia trio de volta pro draft e
/// re-aponta `activeVersionId`.
///
/// `handoffConfig` JSONB carrega o estado dos 6 gatilhos de handoff
/// (manual, keyword, commercial_intent, stage_negotiation,
/// outside_business_hours, agent_to_agent). Shape validado por Zod no
/// Server Action — não criamos tabela separada porque os 6 são fixos.
///
/// `templateKey` é soft (varchar, não enum) — alinhado com lookup de M5
/// (`AgentTemplateKey: 'qualification' | 'attendance' | 'recovery' | 'blank'`).
model AiAgent {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String      @map("workspace_id") @db.Uuid
  name            String      @db.VarChar(80)
  status          AgentStatus @default(testing)
  persona         String      @default("") @db.VarChar(280)
  tone            AgentTone   @default(consultivo)
  avatarEmoji     String?     @map("avatar_emoji") @db.VarChar(8)
  templateKey     String?     @map("template_key") @db.VarChar(32)
  prompt          String      @default("")
  activeVersionId String?     @map("active_version_id") @db.Uuid
  handoffConfig   Json        @default("{}") @map("handoff_config")
  createdById     String?     @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?                @relation("AiAgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activeVersion AgentVersion?        @relation("AiAgentActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions      AgentVersion[]       @relation("AiAgentVersions")
  routingRules  AgentRoutingRule[]
  sessions      AgentSession[]
  leadSummaries LeadSummary[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
  @@map("ai_agents")
}

/// Snapshot imutável do trio (prompt+persona+tone). Roteamento e
/// handoffConfig NÃO entram na versão (mudanças neles são instantâneas e
/// não-versionadas). Restore não cria row aqui — copia trio pro draft do
/// agente + reaponta `activeVersionId`.
model AgentVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  versionNumber Int      @map("version_number")
  prompt        String
  persona       String   @default("") @db.VarChar(280)
  tone          AgentTone
  notes         String?  @db.VarChar(280)
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agent             AiAgent        @relation("AiAgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  createdBy         User?          @relation("AgentVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  agentsUsingActive AiAgent[]      @relation("AiAgentActiveVersion")
  sessions          AgentSession[]

  @@unique([agentId, versionNumber])
  @@index([agentId])
  @@map("agent_versions")
}

/// Regra de roteamento. Match no PRIMEIRO HIT ordenado por `priority` asc.
/// UI controla `priority` via drag-and-drop em M11#3. Sem unique (workspace
/// pode ter 2 regras idênticas; UI deduplica no save, schema não impõe).
model AgentRoutingRule {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId   String         @map("agent_id") @db.Uuid
  kind      AgentRouteKind
  value     String         @db.VarChar(120)
  priority  Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, priority])
  @@index([kind, value])
  @@map("agent_routing_rules")
}

/// Sessão de conversa atendida por um agente.
///   - `kind=production` → conversationId+leadId NOT NULL, persiste em
///     `AgentMessage`, alimenta métricas, dispara handoff
///   - `kind=simulation` → chat de teste no editor, sem efeito colateral
///     (conversationId+leadId NULL)
///
/// `versionId` registra qual versão do agente atendeu — útil pra debug
/// ("essa resposta saiu na v3 ou na v4?"). `endedAt` NULL = sessão ativa.
model AgentSession {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  agentId        String           @map("agent_id") @db.Uuid
  versionId      String?          @map("version_id") @db.Uuid
  conversationId String?          @map("conversation_id") @db.Uuid
  leadId         String?          @map("lead_id") @db.Uuid
  kind           AgentSessionKind @default(production)
  startedAt      DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?        @map("ended_at") @db.Timestamptz(6)
  endedReason    String?          @map("ended_reason") @db.VarChar(64)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent        AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version      AgentVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages     AgentMessage[]

  @@index([workspaceId, agentId, startedAt(sort: Desc)])
  @@index([conversationId])
  @@map("agent_sessions")
}

/// Log interno do diálogo IA (camada SESSÃO da memória 3 camadas).
/// Append-only — sem UPDATE/DELETE policy. SEPARADO de `Message` (M9) porque
/// inclui mensagens de simulation (não vão pro WhatsApp) e contabiliza
/// tokens Claude.
///
/// `cacheReadInputTokens` ≠ 0 indica prompt caching efetivo
/// (CLAUDE.md §6 — caching obrigatório no system+base estável).
model AgentMessage {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String           @map("workspace_id") @db.Uuid
  sessionId                String           @map("session_id") @db.Uuid
  direction                MessageDirection
  body                     String
  model                    String?          @db.VarChar(64)
  inputTokens              Int?             @map("input_tokens")
  outputTokens             Int?             @map("output_tokens")
  cacheReadInputTokens     Int?             @map("cache_read_input_tokens")
  cacheCreationInputTokens Int?             @map("cache_creation_input_tokens")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("agent_messages")
}

/// Resumo persistente do lead (camada LEAD da memória 3 camadas).
/// Compartilhado entre agentes do workspace — lead atende com agente A,
/// resumo é visto pelo agente B na próxima sessão. Atualizado por job
/// após cada interação (M11#2 background).
model LeadSummary {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  leadId            String   @unique @map("lead_id") @db.Uuid
  summary           String   @default("")
  updatedByAgentId  String?  @map("updated_by_agent_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  updatedByAgent AiAgent?  @relation(fields: [updatedByAgentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("lead_summaries")
}

/// 5 campos estruturados do "Cérebro da Empresa" (PRD §3.9). Singleton por
/// workspace (UNIQUE em workspaceId). Mudança em campo re-gera chunks
/// `source=structured_field` via job (M11#4).
model KnowledgeBaseField {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  about       String   @default("")
  products    String   @default("")
  faq         String   @default("")
  scripts     String   @default("")
  policy      String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("knowledge_base_fields")
}

/// Documento uploadado pro Cérebro (PDF/DOC/DOCX/TXT/MD, ≤ 10MB). Arquivo
/// vive em Supabase Storage (`storageBucket`/`storagePath`); aqui só
/// metadata + status do pipeline (uploading → processing → processed | failed).
/// Soft-delete via `deletedAt` (cleanup de órfãos no Storage via pg_cron em M13).
model KnowledgeDocument {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  name           String             @db.VarChar(255)
  kind           KnowledgeDocKind
  sizeBytes      Int                @map("size_bytes")
  status         KnowledgeDocStatus @default(uploading)
  storageBucket  String             @default("knowledge-base") @map("storage_bucket") @db.VarChar(64)
  storagePath    String             @map("storage_path")
  errorDetail    String?            @map("error_detail")
  uploadedById   String?            @map("uploaded_by_id") @db.Uuid
  processedAt    DateTime?          @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(6)

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User?            @relation("KnowledgeDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks     KnowledgeChunk[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
  @@map("knowledge_documents")
}

/// Pedaço de texto pra busca semântica. Discriminado via `source`:
///   - `document` → `documentId` NOT NULL, `structuredField` NULL
///   - `structured_field` → `documentId` NULL, `structuredField` em
///     {about|products|faq|scripts|policy}
///
/// SEM unique — re-chunking gera rows novas (delete-and-insert em transação).
model KnowledgeChunk {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String              @map("workspace_id") @db.Uuid
  documentId      String?             @map("document_id") @db.Uuid
  source          KnowledgeSourceKind
  structuredField String?             @map("structured_field") @db.VarChar(32)
  content         String
  tokens          Int                 @default(0)
  chunkIndex      Int                 @default(0) @map("chunk_index")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document   KnowledgeDocument?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding  KnowledgeEmbedding?

  @@index([workspaceId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

/// Embedding vetorial 1536-dim (text-embedding-3-small da OpenAI) por chunk.
/// Separado pra:
///   1. Permitir re-embed (mudou de modelo) sem rewrite dos chunks
///   2. Isolar HNSW index numa tabela menor
///
/// `workspaceId` duplicado pra que top-K filtre antes do ORDER BY (HNSW +
/// WHERE workspaceId é mais eficiente que JOIN com chunks).
///
/// **Tipo `embedding`**: Prisma 5 não tipa `vector(N)` nativamente — usamos
/// `Unsupported` pra que o client conheça a coluna mas leitura/escrita só
/// via `$queryRaw`/`$executeRaw` (que é o que pgvector exige pra `<=>`).
model KnowledgeEmbedding {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chunkId     String                       @unique @map("chunk_id") @db.Uuid
  workspaceId String                       @map("workspace_id") @db.Uuid
  embedding   Unsupported("vector(1536)")
  model       String                       @default("text-embedding-3-small") @db.VarChar(64)
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunk     KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("knowledge_embeddings")
}

/// Metering cross-feature de uso de IA (M11#2). Append-only — sem policy
/// UPDATE/DELETE. `cost_micros` é USD × 10^6 (bigint) pra evitar float drift
/// em SUM. `entity_kind`/`entity_id` opcionais — discriminam qual entidade
/// originou o uso (`agent_session`/`agent_message`/`knowledge_document`/
/// `lead_summary`). Sem FK declarada pra evitar cascade pesada + permitir
/// entity_kind novo sem migration.
model UsageEvent {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String         @map("workspace_id") @db.Uuid
  eventKind                UsageEventKind @map("event_kind")
  feature                  String         @db.VarChar(32)
  model                    String         @db.VarChar(64)
  inputTokens              Int            @default(0) @map("input_tokens")
  outputTokens             Int            @default(0) @map("output_tokens")
  cacheReadInputTokens     Int            @default(0) @map("cache_read_input_tokens")
  cacheCreationInputTokens Int            @default(0) @map("cache_creation_input_tokens")
  costMicros               BigInt         @default(0) @map("cost_micros")
  entityKind               String?        @map("entity_kind") @db.VarChar(32)
  entityId                 String?        @map("entity_id") @db.Uuid
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, eventKind, createdAt(sort: Desc)])
  @@index([entityKind, entityId])
  @@map("usage_events")
}
