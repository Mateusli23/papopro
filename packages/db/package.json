{
  "name": "@papopro/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, client e migrations do PapoPro. Esqueleto de M1; schema real chega em M7+.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "prisma",
    "package.json"
  ],
  "scripts": {
    "lint": "eslint --max-warnings=0 \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .turbo node_modules",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:format": "prisma format"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@papopro/config": "workspace:*",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
