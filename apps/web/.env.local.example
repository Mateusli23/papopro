# =============================================================================
# apps/web/.env.local.example — template
# =============================================================================
# Copie para `.env.local` (gitignored) e preencha. Subset do produto.
# Ver `docs/SETUP.md` pra ordem de prioridade e onde gerar cada chave.
# A raiz `/.env.example` lista TODAS as variáveis do monorepo se precisar.

# URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_LANDING_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_NAME="PapoPro"

# Supabase (M7)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""
DIRECT_URL=""

# WhatsApp uazapi (M9)
UAZAPI_BASE_URL=""
UAZAPI_API_KEY=""
UAZAPI_WEBHOOK_SECRET=""

# IA (M11)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Stripe (M12)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_AI_MONTHLY=""

# Resend (M7)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="PapoPro <no-reply@pipeflow.com.br>"
RESEND_REPLY_TO="suporte@pipeflow.com.br"
# RESEND_MODE: leave empty in dev/prod. Set to "outbox" pra que `sendEmail`
# desvie pra `apps/web/e2e/.tmp/outbox.jsonl` (Playwright E2E lê dali). Ver
# `docs/SETUP.md` §"Rodar E2E localmente".
RESEND_MODE=""

# Playwright E2E (M7#6) — apenas pra rodar specs Playwright, NUNCA em prod
E2E_SUPABASE_URL=""
E2E_SUPABASE_SERVICE_ROLE_KEY=""
E2E_BASE_URL="http://localhost:3000"

# Web Push VAPID (gere com: `node scripts/generate-vapid.mjs --env`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:suporte@pipeflow.com.br"

# Secret do POST /api/internal/notify (M13#2) — usado pelos triggers Postgres
# (notify_on_cold_lead_alert / notify_on_whatsapp_unhealthy) via pg_net.
# O operador configura o MESMO valor em Postgres:
#   ALTER DATABASE postgres SET app.notify_dispatch_secret = '<valor>';
#   ALTER DATABASE postgres SET app.app_url = 'https://app.pipeflow.com.br';
NOTIFY_DISPATCH_SECRET=""

# Google Calendar OAuth (M8)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"

# Sentry (M2+)
NEXT_PUBLIC_SENTRY_DSN_WEB=""
SENTRY_ORG=""
SENTRY_PROJECT_WEB=""
SENTRY_AUTH_TOKEN=""

# PostHog (M2+)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Auth (gere com: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
AUTH_COOKIE_DOMAIN="localhost"
AUTH_SECRET=""

# Cron secret (M8#6 — cleanup orphan attachments)
# Gere com: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
CRON_SECRET=""

# Misc
NODE_ENV="development"
LOG_LEVEL="debug"
TZ="America/Sao_Paulo"
