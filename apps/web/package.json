{
  "name": "@papopro/web",
  "version": "0.1.0",
  "private": true,
  "description": "PapoPro produto/PWA — app.pipeflow.com.br",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings=0 \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"middleware.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next .turbo node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/poppins": "5.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@papopro/db": "workspace:*",
    "@papopro/ui": "workspace:*",
    "@prisma/client": "^6.1.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "date-fns": "^4.1.0",
    "next": "14.2.20",
    "react": "^18.3.1",
    "react-day-picker": "^9.4.4",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.0",
    "@papopro/config": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "14.2.20",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
