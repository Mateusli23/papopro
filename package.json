{
  "name": "papopro",
  "version": "0.1.0",
  "private": true,
  "description": "PapoPro — CRM SaaS multi-empresa com WhatsApp, cadência automática e agentes IA. Monorepo Turborepo + pnpm.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "20.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "db:push": "pnpm --filter @papopro/db db:push",
    "db:migrate": "pnpm --filter @papopro/db db:migrate",
    "db:studio": "pnpm --filter @papopro/db db:studio",
    "db:generate": "pnpm --filter @papopro/db db:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@papopro/config": "workspace:*",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "pnpm exec eslint --fix --no-error-on-unmatched-pattern",
      "pnpm exec prettier --write --ignore-unknown"
    ],
    "*.{json,md,css,yml,yaml}": [
      "pnpm exec prettier --write --ignore-unknown"
    ]
  }
}
