{
  "permissions": {
    "allow": [
      "PowerShell($env:NODE_OPTIONS = \"--use-system-ca\"; npm install -g pnpm@9.15.0 2>&1 | Select-Object -Last 10)",
      "PowerShell(pnpm --version)",
      "PowerShell(git add .gitignore .gitattributes CLAUDE.md docs/ .mcp.json)",
      "PowerShell(git checkout -b m1-setup)",
      "PowerShell($env:NODE_OPTIONS = \"--use-system-ca\"; $env:NEXT_TELEMETRY_DISABLED = \"1\"; $env:TURBO_TELEMETRY_DISABLED = \"1\"; pnpm install 2>&1 | Select-Object -Last 60)",
      "PowerShell(Remove-Item Env:NODE_OPTIONS -ErrorAction SilentlyContinue; $env:NEXT_TELEMETRY_DISABLED = \"1\"; $env:TURBO_TELEMETRY_DISABLED = \"1\"; pnpm install 2>&1 | Select-Object -Last 40)"
    ]
  },
  "enabledPlugins": {
    "stripe@claude-plugins-official": true
  }
}
