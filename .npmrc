auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
prefer-workspace-packages=true
link-workspace-packages=deep
save-workspace-protocol=rolling

# Nota: `use-node-version` foi removido porque a Vercel rejeita esse campo
# (build falha com "Detected unsupported 'use-node-version'"). A versão do
# Node fica controlada pelo `engines.node` em `package.json` — localmente,
# garanta Node 20+ via nvm/Volta/asdf, ou rode `node --version` pra confirmar.
